# Nginx reverse-proxy config for Memos (HTTPS) - www.yingshun.xin
#
# Memos upstream: http://127.0.0.1:8081
#
# macOS Homebrew nginx tip:
# - Config include dir:
#   - Apple Silicon: /opt/homebrew/etc/nginx/servers/
#   - Intel:        /usr/local/etc/nginx/servers/
# - Put this file there (or include it from nginx.conf)

upstream memos_upstream {
  server 127.0.0.1:8081;
  keepalive 32;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;
  listen [::]:80;
  server_name yingshun.xin www.yingshun.xin;

  # Use www as the canonical host.
  return 301 https://www.yingshun.xin$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name yingshun.xin www.yingshun.xin;

  # Redirect apex to www.
  if ($host = yingshun.xin) {
    return 301 https://www.yingshun.xin$request_uri;
  }

  # Update paths to your certs
  # Homebrew nginx cert path:
  # - Apple Silicon: /opt/homebrew/etc/nginx/certs/
  # - Intel:        /usr/local/etc/nginx/certs/
  ssl_certificate     /usr/local/etc/nginx/certs/www.yingshun.xin.crt;
  ssl_certificate_key /usr/local/etc/nginx/certs/www.yingshun.xin.key;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  client_max_body_size 100m;

  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_http_version 1.1;
  proxy_set_header Upgrade    $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  proxy_read_timeout  300s;
  proxy_send_timeout  300s;

  # Keep client connections alive for long media downloads.
  keepalive_timeout 300s;

  # Long audio/video download path (iOS resume/range sensitive).
  # Keep this location BEFORE the generic "/" location.
  location ^~ /file/attachments/ {
    proxy_pass http://memos_upstream;

    # Avoid buffering large downloads in nginx temp files.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;
    add_header X-Accel-Buffering no always;

    # Preserve range headers for resume/partial download.
    proxy_set_header Range    $http_range;
    proxy_set_header If-Range $http_if_range;

    # Long-running transfer safety.
    proxy_connect_timeout 300s;
    proxy_read_timeout    300s;
    proxy_send_timeout    300s;
    send_timeout          300s;
  }

  location / {
    proxy_pass http://memos_upstream;
  }
}
